# ========================================================
# Indra Hotel - Security & Clean URL Rewriting
# ========================================================

# Disable Directory Index Browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Block direct web access to sensitive private folders
    RewriteRule ^(scripts|k8s|includes|\.git) - [F,L]

    # 2. Block direct access to sensitive file extensions
    <FilesMatch "\.(sqlite|sql|env|ini|log|md|sh|yml|yaml|git.*|json)$">
        Require all denied
    </FilesMatch>

    # 3. Block direct access to critical build/configuration files
    <FilesMatch "^(Dockerfile|Makefile|composer\.json|composer\.lock)$">
        Require all denied
    </FilesMatch>

    # 4. Allow direct access to valid physical assets (CSS, JS, images, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Route all other application requests to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
